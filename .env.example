# =============================================================================
# Aviary — Environment Variables
# =============================================================================
# Copy this file to .env and fill in all values before starting the server.
#
# HEROKU SETUP: Set each variable with:
#   heroku config:set KEY=VALUE --app meta-avian
#
# For multiple vars at once:
#   heroku config:set KEY1=val1 KEY2=val2 --app meta-avian
# =============================================================================

# --- App ---
# Runtime environment: development | production
NODE_ENV=

# TCP port the server listens on (Heroku sets this automatically)
PORT=

# --- Database ---
# MongoDB connection string.
# Local: mongodb://localhost:27017/aviary
# Heroku / Atlas: append the database name to the cluster URI, e.g.:
#   mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/aviary?retryWrites=true&w=majority&appName=dev
# Important: whitelist 0.0.0.0/0 in Atlas Network Access (Heroku has no static IP)
MONGODB_URI=

# --- JWT ---
# Long random string used to sign JSON Web Tokens (generate with: openssl rand -hex 64)
JWT_SECRET=

# How long issued tokens remain valid (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# --- Session ---
# Long random string for express-session cookie signing (generate with: openssl rand -hex 64)
# Only used during the OAuth2 redirect round-trip; not for application sessions.
SESSION_SECRET=

# --- Google OAuth2 ---
# Created at https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match exactly what is registered in Google Cloud Console
# Production: https://meta-avian.herokuapp.com/api/v1/auth/google/callback
GOOGLE_CALLBACK_URL=

# --- Apple Sign In ---
# Services ID (e.g. com.metaavian.web) — created in Apple Developer Portal
APPLE_CLIENT_ID=

# 10-character team ID from Apple Developer account (top-right of developer.apple.com)
APPLE_TEAM_ID=

# Key ID of the Sign in with Apple private key (created under Certificates, IDs & Keys)
APPLE_KEY_ID=

# Contents of the .p8 private key file, base64-encoded as a single line.
# Encode: cat AuthKey_XXXXXXXXXX.p8 | base64
# On macOS the output may be multi-line — join it into one line before setting.
# The server decodes it back to PEM at runtime.
APPLE_PRIVATE_KEY=

# Must match exactly what is registered in Apple Developer Portal
# Production: https://meta-avian.herokuapp.com/api/v1/auth/apple/callback
APPLE_CALLBACK_URL=

# --- SMTP2Go ---
# API key from https://app.smtp2go.com/ → Settings → API Keys
# Required for transactional email (verification, password reset).
# If absent in development, email sending is skipped with a console warning.
SMTP2GO_API_KEY=

# "From" address for all outgoing emails. Must be a verified sender in SMTP2Go.
# DNS note for metaavian.com (configure in Squarespace):
#   - Change SPF record from "v=spf1 -all" to "v=spf1 include:sendgrid.net ~all"
#   - Add the DKIM CNAME records provided by SMTP2Go after domain verification
#   - DMARC can remain as-is once SPF and DKIM are passing
EMAIL_FROM=noreply@metaavian.com

# --- Client ---
# Full URL of the front-end app (no trailing slash).
# Development: http://localhost:5173 (Vite default)
# Production:  https://meta-avian.herokuapp.com  (or custom domain)
CLIENT_URL=
