{
  "name": "meta-avian",
  "version": "1.7.5",
  "description": "Aviary — Daily Bird Taxonomy Guessing Game",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"nodemon server.js\" \"npm run client:dev\"",
    "client:dev": "cd client && npm run dev",
    "build": "cd client && npm install && npm run build",
    "heroku-postbuild": "npm run build",
    "seed:birds": "node scripts/seed-birds.js",
    "seed:puzzles": "node scripts/seed-puzzles.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^5.0.0",
    "express-rate-limit": "^7.0.0",
    "express-session": "^1.18.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.0.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.9.0",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "nodemon": "^3.1.0"
  }
}
